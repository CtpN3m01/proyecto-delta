# URL pública usada por la CLI que se ejecuta en el host.
COORDINATOR_URL=http://localhost:8000

# URLs públicas de los tres Node Agents que el Coordinator devuelve a la CLI.
PARTY_URLS=http://localhost:8100,http://localhost:8101,http://localhost:8102

# Control del Node Agent (Compose asigna un PARTY_ID distinto por servicio).
COORDINATOR_INTERNAL_URL=http://coordinator-api:8000
PARTY_ID=0
MPC_RUNTIME_ENABLED=1
MPSPDZ_ROOT=/opt/MP-SPDZ
MPC_HOSTS_FILE=/app/mpc/hosts-docker
# El nuevo programa acepta identidad y anonimización explícita en el mismo runtime.
MPC_PROGRAM=delta_video_anonymize


MPC_MAX_WIDTH=1920
MPC_MAX_HEIGHT=1080
# Desde la CLI se puede escoger una caja menor con --mpc-max-width/--mpc-max-height.
# Máximos de entrada, no garantía de tiempo real. Sin límite fijo de duración.
# El cliente muestrea hasta 30 FPS; --mpc-fps permite perfiles menores.
# La preparación sigue usando memoria proporcional al video completo.
DELTA_WEB_ORIGINS=http://127.0.0.1:5173,http://localhost:5173,http://127.0.0.1:4173,http://localhost:4173
# Opcional: límite de tamaño comprimido para proteger el disco del servicio.
DELTA_MAX_UPLOAD_MB=

# ExternalIO desde la CLI en el host.
MPC_PARTY_HOSTS=localhost,localhost,localhost
MPC_CLIENT_PORT_BASE=14000
MPC_CLIENT_ID=0
MPC_CERT_DIR=.runtime/Player-Data
DELTA_OUTPUT_DIR=output
